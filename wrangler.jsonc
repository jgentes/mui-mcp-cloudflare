/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mui-mcp-cloudflare",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": ["nodejs_compat"],
	"migrations": [
		{
			"new_sqlite_classes": ["MyMCP"],
			"tag": "v1"
		},
		{
			// v2: the server is stateless, but the agents SDK creates one Durable
			// Object per MCP client session and never cleans them up, so the
			// MyMCP class accumulated tens of GB of orphaned session storage.
			// The replacement class starts empty and destroys idle sessions
			// itself (see src/index.ts). Cloudflare refuses to delete a class
			// while the live version still binds it (error 10061), so this is
			// step 1 of 2: move the binding here, then delete MyMCP in v3 once
			// this version is live.
			"new_sqlite_classes": ["MuiMcpAgent"],
			"tag": "v2"
		}
		// Step 2 (next deploy): uncomment to drop MyMCP and all of its data,
		// and remove the MyMCP stub export from src/index.ts.
		// {
		// 	"deleted_classes": ["MyMCP"],
		// 	"tag": "v3"
		// }
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "MuiMcpAgent",
				"name": "MCP_OBJECT"
			}
		]
	},
	"observability": {
		"enabled": true
	}
}
